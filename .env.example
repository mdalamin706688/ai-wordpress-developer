# Copy to .env and fill in. Never commit .env.

DEEPSEEK_API_KEY=
ZAI_API_KEY=
NVIDIA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Google AI Studio key (AIza… or AQ.…). Used by Free chip: Flash 3.5 / Flash-Lite.
GEMINI_API_KEY=
# Client billed Gemini key — Paid chip only (3.6 / 3.7 / 3.8 Flash, 3.1 Pro).
# Free models never use this key.
GEMINI_PAID_API_KEY=
# Optional: force Gemini free-account tier probe (true=paid / false=free). Leave unset for auto.
# GEMINI_BILLING_ENABLED=false
MOONSHOT_API_KEY=
MINIMAX_API_KEY=
# Alibaba DashScope / Model Studio (OpenAI-compatible). Trial tokens then paid.
QWEN_API_KEY=
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Google Sheets export (public OAuth Client ID only — never commit secrets)
# Add authorized JS origins: http://127.0.0.1:8765 and http://localhost:8765
GOOGLE_CLIENT_ID=
GOOGLE_SHEETS_FOLDER_ID=

# Optional until a WordPress target exists
WP_SITE_URL=
WP_USER=bbs-ai-builder
WP_APP_PASSWORD=

# Intake API (API Bridge → this service)
INTAKE_API_KEY=dev-local-key
HOST=0.0.0.0
PORT=8080

# Preferred production stack (lab UI can still override per run)
WRITER_MODEL=gemini-3.6-flash
VERIFIER_MODEL=gemini-3.5-flash-lite
DEFAULT_COPY_MODEL=gemini-3.6-flash
DEFAULT_COMPOSE_MODEL=gemini-3.5-flash-lite

# Comma-separated origins for GitHub Pages demo (use * for quick preview)
CORS_ORIGINS=*
